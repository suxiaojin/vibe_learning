generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  admin
}

enum UserStatus {
  active
  disabled
}

enum PasswordChangeSource {
  student_self
  admin_reset
}

enum StudentGender {
  male
  female
}

enum DiamondTransactionType {
  register_bonus
  daily_active_bonus
  daily_answer_bonus
  purchase
  admin_adjust
  ai_consumption
  project_purchase
}

enum StudyProjectKind {
  ai
  official
}

enum DiamondRuleDirection {
  grant
  consume
}

enum ContentStatus {
  draft
  published
  archived
}

enum NotificationStatus {
  draft
  sent
  archived
}

enum NotificationSource {
  manual
  scheduled
  automated
}

enum NotificationDispatchType {
  immediate
  scheduled
  automated
}

enum NotificationDispatchStatus {
  pending
  processing
  sent
  cancelled
  failed
}

enum NotificationChannel {
  in_app
  email
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  skipped
}

enum NotificationAutomationEventType {
  user_registered
  admin_diamond_added
  diamond_purchase_succeeded
}

enum BuddyPairStatus {
  available
  active
  rejected
  removed
}

enum BuddyRequestStatus {
  pending
  accepted
  rejected
  withdrawn
  expired
}

enum BuddyPostType {
  original
  repost
}

enum BuddyPostShareType {
  question_card
  quiz_result_card
  active_learning_card
}

enum ShareCopyContext {
  question_correct
  question_wrong
  quiz_passed
  quiz_failed
  active_learning
}

enum UserEventNotificationType {
  buddy_request_received
  buddy_request_accepted
  buddy_request_rejected
  buddy_post_liked
  buddy_post_reposted
  social_followed
}

enum RegionStatus {
  active
  inactive
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  fill_blank
  calculation
  proof
  comprehensive
  term_explanation
  calculation_analysis
  practical_writing
  short_answer
  essay
  comprehensive_analysis
  material_analysis
  operation_record
  practical_operation
  application
  question_answer
  handwriting
  reading_comprehension
  poetry_appreciation
  classical_chinese_translation
  writing
  legal_document
  chinese_character_writing
  language_expression
  teaching_design
  comprehensive_essay
}

enum Difficulty {
  easy
  medium
  hard
}

enum ProgressStatus {
  locked
  unlocked
  passed
}

enum WrongQuestionStatus {
  active
  mastered
}

enum QuizSessionStatus {
  in_progress
  completed
}

enum QuestionAttemptGradingStatus {
  auto_graded
  ungraded
}

enum LearningCourseType {
  public_subject
  major
}

enum LearningChallengeMode {
  chapter
  course
}

enum LearningCheckpointScope {
  course
}

enum QuestionBankOwnerType {
  public_subject
  major
}

enum SyllabusRequirement {
  know
  understand
  master
  apply
}

enum PaperType {
  real_exam
  mock_exam
  practice_set
}

enum QuestionSourceType {
  manual
  real_exam
  outline
  import
  ai_generated
}

enum QuestionKnowledgeTagSource {
  ai
  manual
}

enum AiStudySourceType {
  pdf
  document
  image
  text
  mixed
}

enum AiStudyLearningGoal {
  preview
  review
  sprint
  weak_point
  other
}

enum AiStudyVisibility {
  private
  public_pending
  public
  rejected
}

enum AiStudyProjectStatus {
  draft
  processing
  ready
  failed
  archived
}

enum AiStudySourceStatus {
  uploaded
  parsed
  failed
}

enum AiStudyNodeStatus {
  draft
  ready
  hidden
}

enum AiStudyCardReviewStatus {
  unreviewed
  approved
  rejected
}

enum AiStudyProgressStatus {
  not_started
  learning
  review_needed
  mastered
}

enum AiStudyTaskType {
  parse_source
  generate_outline
  generate_cards
  generate_quiz
  quality_check
}

enum AiStudyTaskStatus {
  pending
  running
  succeeded
  failed
  canceled
}

enum OfficialStudyMaterialFileType {
  pdf
  word
}

enum OfficialStudyMaterialFileStatus {
  uploading
  ready
  failed
}

enum OfficialStudyMaterialVisibility {
  draft
  public
  offline
}

model User {
  id                                 String                          @id @default(cuid())
  username                           String                          @unique
  passwordHash                       String
  role                               UserRole                        @default(student)
  status                             UserStatus                      @default(active)
  phoneNumber                        String?
  email                              String?
  adminRemark                        String?
  createdAt                          DateTime                        @default(now())
  lastLoginAt                        DateTime?
  lastActiveAt                       DateTime?
  disabledAt                         DateTime?
  disabledReason                     String?
  studentProfile                     StudentProfile?
  progress                           UserProgress[]
  attempts                           QuestionAttempt[]
  quizSessions                       QuizSession[]
  wrongQuestions                     WrongQuestion[]
  aiConversations                    AiConversation[]
  studyStats                         StudyStat[]
  syllabusProgress                   UserSyllabusProgress[]
  diamondAccount                     DiamondAccount?
  diamondTransactions                DiamondTransaction[]
  studyProjectPurchases              StudyProjectPurchase[]
  diamondRuleConfigsUpdated          DiamondRuleConfig[]             @relation("DiamondRuleConfigUpdater")
  passwordChangeLogs                 PasswordChangeLog[]             @relation("PasswordChangeTarget")
  passwordChangesMade                PasswordChangeLog[]             @relation("PasswordChangeActor")
  sentNotifications                  Notification[]                  @relation("NotificationAuthor")
  notificationTemplates              NotificationTemplate[]          @relation("NotificationTemplateAuthor")
  notificationRecipients             NotificationRecipient[]
  notificationDispatchJobsCreated    NotificationDispatchJob[]       @relation("NotificationDispatchJobAuthor")
  notificationAutomationRulesCreated NotificationAutomationRule[]    @relation("NotificationAutomationRuleAuthor")
  notificationEvents                 NotificationEvent[]
  notificationDispatchRecipients     NotificationDispatchRecipient[]
  buddyPairsAsA                      BuddyPair[]                     @relation("BuddyPairUserA")
  buddyPairsAsB                      BuddyPair[]                     @relation("BuddyPairUserB")
  buddyPairsTerminated               BuddyPair[]                     @relation("BuddyPairTerminalActor")
  buddyRequestsSent                  BuddyRequest[]                  @relation("BuddyRequestRequester")
  buddyRequestsReceived              BuddyRequest[]                  @relation("BuddyRequestRecipient")
  buddyPosts                         BuddyPost[]                     @relation("BuddyPostAuthor")
  buddyPostLikes                     BuddyPostLike[]
  following                          SocialFollow[]                  @relation("SocialFollowFollower")
  followers                          SocialFollow[]                  @relation("SocialFollowFollowing")
  buddyFeedReadState                 BuddyFeedReadState?
  blockedUsers                       SocialBlock[]                   @relation("SocialBlockBlocker")
  blockedBy                          SocialBlock[]                   @relation("SocialBlockBlocked")
  userEventNotificationsReceived     UserEventNotification[]         @relation("UserEventNotificationRecipient")
  userEventNotificationsActed        UserEventNotification[]         @relation("UserEventNotificationActor")
  aiStudyProjects                    AiStudyProject[]                @relation("AiStudyProjectOwner")
  aiStudyProgress                    AiStudyProgress[]
  aiStudyChatMessages                AiStudyChatMessage[]
  officialStudyMaterialsCreated      OfficialStudyMaterial[]         @relation("OfficialStudyMaterialCreator")

  @@index([role, status, createdAt])
  @@index([role, status, lastActiveAt])
  @@map("users")
}

model EmailVerificationCode {
  id           String    @id @default(cuid())
  email        String
  purpose      String    @default("register")
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  lastSentAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([email, purpose, expiresAt])
  @@index([email, purpose, lastSentAt])
  @@map("email_verification_codes")
}

model AdminModule {
  id        String        @id @default(cuid())
  key       String        @unique
  label     String
  href      String
  icon      String        @default("settings")
  status    ContentStatus @default(published)
  sortOrder Int           @default(0)
  builtIn   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
  @@map("admin_modules")
}

model SystemSetting {
  id                        String   @id @default("default")
  loginHeroImageUrl         String   @default("/login-hero-vibelearning.png")
  loginMarketingIcon        String   @default("gift")
  loginMarketingTitle       String   @default("新注册用户限时赠送学习加速包")
  loginMarketingDescription String   @default("完成注册即可开启江苏专转本计算机闯关学习")
  loginWelcomeTitle         String   @default("Welcome to VibeLearning")
  userAgreementContent      String   @default("test")
  privacyPolicyContent      String   @default("test")
  platformAgreementContent  String   @default("test")
  faqContent                String   @default("常见问题内容正在完善中。")
  changelogContent          String   @default("")
  customerServiceEmail      String   @default("714399532@qq.com")
  diamondRechargeQrCodeUrl  String   @default("")
  profileHomepageBackgroundImageUrl String @default("")
  profileHomepageBackgroundUpdatedAt DateTime?
  learningPathTheme          String   @default("default")
  studyBuddyHeroImageUrl    String   @default("/ai-study/study-buddy-hero.webp")
  studyBuddyHeroTitle       String   @default("好好学习，早日上岸")
  studyBuddyHeroEffect      String   @default("typewriter")
  studyBuddyHeroTypeSpeedMs Int      @default(105)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}

model ShareCopyStyle {
  id        String            @id @default(cuid())
  context   ShareCopyContext
  label     String
  status    ContentStatus     @default(published)
  sortOrder Int               @default(0)
  phrases   ShareCopyPhrase[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([context, status, sortOrder])
  @@map("share_copy_styles")
}

model ShareCopyPhrase {
  id        String         @id @default(cuid())
  styleId   String
  content   String
  status    ContentStatus  @default(published)
  sortOrder Int            @default(0)
  style     ShareCopyStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([styleId, status, sortOrder])
  @@map("share_copy_phrases")
}

model Region {
  id              String                @id @default(cuid())
  name            String                @unique
  province        String
  studySystem     String
  description     String?
  status          RegionStatus          @default(active)
  sortOrder       Int                   @default(0)
  publicSubjects  RegionPublicSubject[]
  majors          RegionMajor[]
  studentProfiles StudentProfile[]
  learningCourses LearningCourse[]
  examPapers      ExamPaper[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([province, studySystem])
  @@index([status, sortOrder])
  @@map("regions")
}

model PublicSubject {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  code                   String?                 @unique
  description            String?
  status                 ContentStatus           @default(draft)
  sortOrder              Int                     @default(0)
  regions                RegionPublicSubject[]
  studentProfiles        StudentProfile[]
  learningCourses        LearningCourse[]
  examPapers             ExamPaper[]
  officialStudyMaterials OfficialStudyMaterial[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, sortOrder])
  @@map("public_subjects")
}

model Major {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  description            String?
  status                 ContentStatus           @default(draft)
  sortOrder              Int                     @default(0)
  regions                RegionMajor[]
  studentProfiles        StudentProfile[]
  learningCourses        LearningCourse[]
  examPapers             ExamPaper[]
  officialStudyMaterials OfficialStudyMaterial[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, sortOrder])
  @@map("majors")
}

model School {
  id              String           @id @default(cuid())
  name            String
  province        String           @default("未设置")
  status          ContentStatus    @default(published)
  sortOrder       Int              @default(0)
  studentProfiles StudentProfile[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([province, name])
  @@index([status, sortOrder])
  @@map("schools")
}

model RegionPublicSubject {
  id              String        @id @default(cuid())
  regionId        String
  publicSubjectId String
  region          Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  publicSubject   PublicSubject @relation(fields: [publicSubjectId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([regionId, publicSubjectId])
  @@index([regionId])
  @@index([publicSubjectId])
  @@map("region_public_subjects")
}

model RegionMajor {
  id                       String                  @id @default(cuid())
  regionId                 String
  majorId                  String
  aiExplainPromptProfileId String?
  region                   Region                  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  major                    Major                   @relation(fields: [majorId], references: [id], onDelete: Cascade)
  aiExplainPromptProfile   AiExplainPromptProfile? @relation(fields: [aiExplainPromptProfileId], references: [id], onDelete: SetNull)
  createdAt                DateTime                @default(now())

  @@unique([regionId, majorId])
  @@index([regionId])
  @@index([majorId])
  @@index([aiExplainPromptProfileId])
  @@map("region_majors")
}

model StudentProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  regionId         String?
  publicSubjectId  String?
  majorId          String?
  schoolId         String?
  nickname         String?
  avatarColor      String         @default("green")
  avatarImage      String?
  coverImage       String?
  coverImageUpdatedAt DateTime?
  bio              String?
  gender           StudentGender?
  school           String?
  birthYear        Int?
  birthMonth       Int?
  allowBuddySearch Boolean        @default(true)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  region           Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  publicSubject    PublicSubject? @relation(fields: [publicSubjectId], references: [id], onDelete: SetNull)
  major            Major?         @relation(fields: [majorId], references: [id], onDelete: SetNull)
  schoolOption     School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([regionId])
  @@index([publicSubjectId])
  @@index([majorId])
  @@index([schoolId])
  @@index([allowBuddySearch, gender])
  @@index([allowBuddySearch, schoolId])
  @@index([allowBuddySearch, birthYear, birthMonth])
  @@map("student_profiles")
}

model LearningCourse {
  id                       String                  @id @default(cuid())
  regionId                 String
  publicSubjectId          String?
  majorId                  String?
  name                     String
  courseType               LearningCourseType
  challengeMode            LearningChallengeMode     @default(chapter)
  description              String?
  questionTypeConfig       Json?
  status                   ContentStatus           @default(draft)
  sortOrder                Int                     @default(0)
  region                   Region                  @relation(fields: [regionId], references: [id], onDelete: Cascade)
  publicSubject            PublicSubject?          @relation(fields: [publicSubjectId], references: [id], onDelete: SetNull)
  major                    Major?                  @relation(fields: [majorId], references: [id], onDelete: SetNull)
  chapters                 Chapter[]
  syllabusItems            SyllabusItem[]
  aiStudyProjects          AiStudyProject[]
  officialStudyMaterials   OfficialStudyMaterial[]
  aiExplainPromptProfileId String?
  aiExplainPromptProfile   AiExplainPromptProfile? @relation(fields: [aiExplainPromptProfileId], references: [id], onDelete: SetNull)
  aiConversations          AiConversation[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([regionId, courseType, status, sortOrder])
  @@index([publicSubjectId])
  @@index([majorId])
  @@index([aiExplainPromptProfileId])
  @@map("learning_courses")
}

model SyllabusItem {
  id                String                    @id @default(cuid())
  courseId          String
  parentId          String?
  checkpointScope   LearningCheckpointScope?
  code              String?
  title             String
  description       String?
  requirement       SyllabusRequirement?
  sortOrder         Int                       @default(0)
  status            ContentStatus             @default(draft)
  course            LearningCourse            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent            SyllabusItem?             @relation("SyllabusItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          SyllabusItem[]            @relation("SyllabusItemChildren")
  knowledgePoints   KnowledgePoint[]
  progress          UserSyllabusProgress[]
  quizSessions      QuizSession[]
  challengeVersions ChapterChallengeVersion[] @relation("ChapterChallengeVersions")
  questions         Question[]
  questionTags      QuestionKnowledgeTag[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([courseId, parentId, sortOrder])
  @@unique([courseId, checkpointScope])
  @@index([status, sortOrder])
  @@map("syllabus_items")
}

model Subject {
  id        String        @id @default(cuid())
  province  String
  examType  String
  name      String
  status    ContentStatus @default(published)
  chapters  Chapter[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([province, examType, name])
  @@map("subjects")
}

model Chapter {
  id        String           @id @default(cuid())
  subjectId String
  courseId  String?
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course    LearningCourse?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title     String
  sortOrder Int              @default(0)
  status    ContentStatus    @default(draft)
  points    KnowledgePoint[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([subjectId, sortOrder])
  @@index([courseId, sortOrder])
  @@map("chapters")
}

model KnowledgePoint {
  id               String         @id @default(cuid())
  chapterId        String
  syllabusItemId   String?
  chapter          Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  syllabusItem     SyllabusItem?  @relation(fields: [syllabusItemId], references: [id], onDelete: SetNull)
  title            String
  summary          String
  content          String
  sortOrder        Int            @default(0)
  estimatedMinutes Int            @default(8)
  status           ContentStatus  @default(draft)
  questions        Question[]
  progress         UserProgress[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([chapterId, sortOrder])
  @@index([syllabusItemId])
  @@map("knowledge_points")
}

model Question {
  id                 String                     @id @default(cuid())
  knowledgePointId   String?
  syllabusItemId     String?
  knowledgePoint     KnowledgePoint?            @relation(fields: [knowledgePointId], references: [id], onDelete: SetNull)
  syllabusItem       SyllabusItem?              @relation(fields: [syllabusItemId], references: [id], onDelete: SetNull)
  type               QuestionType
  stem               String
  options            Json
  answer             Json
  analysis           String
  aiDoubtAnswer      String?
  source             String                     @default("人工录入")
  sourceType         QuestionSourceType         @default(manual)
  sourceYear         Int?
  difficulty         Difficulty                 @default(medium)
  status             ContentStatus              @default(draft)
  paperQuestions     ExamPaperQuestion[]
  knowledgeTags      QuestionKnowledgeTag[]
  attempts           QuestionAttempt[]
  wrongQuestions     WrongQuestion[]
  aiConversations    AiConversation[]
  challengeQuestions ChapterChallengeQuestion[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([knowledgePointId, status])
  @@index([syllabusItemId])
  @@index([sourceType, sourceYear])
  @@map("questions")
}

model QuestionKnowledgeTag {
  id             String                     @id @default(cuid())
  questionId     String
  syllabusItemId String
  source         QuestionKnowledgeTagSource @default(manual)
  confidence     Float?
  reason         String?
  question       Question                   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  syllabusItem   SyllabusItem               @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([questionId, syllabusItemId])
  @@index([questionId])
  @@index([syllabusItemId])
  @@index([source])
  @@map("question_knowledge_tags")
}

model ExamPaper {
  id                 String                @id @default(cuid())
  regionId           String
  ownerType          QuestionBankOwnerType
  publicSubjectId    String?
  majorId            String?
  title              String
  year               Int?
  paperType          PaperType             @default(real_exam)
  description        String?
  questionTypeConfig Json?
  status             ContentStatus         @default(draft)
  sortOrder          Int                   @default(0)
  region             Region                @relation(fields: [regionId], references: [id], onDelete: Cascade)
  publicSubject      PublicSubject?        @relation(fields: [publicSubjectId], references: [id], onDelete: Cascade)
  major              Major?                @relation(fields: [majorId], references: [id], onDelete: Cascade)
  questions          ExamPaperQuestion[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([regionId, ownerType, status, sortOrder])
  @@index([publicSubjectId])
  @@index([majorId])
  @@index([year, paperType])
  @@map("exam_papers")
}

model ExamPaperQuestion {
  id         String    @id @default(cuid())
  paperId    String
  questionId String
  sortOrder  Int       @default(0)
  score      Float?
  paper      ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([paperId, questionId])
  @@index([paperId, sortOrder])
  @@index([questionId])
  @@map("exam_paper_questions")
}

model UserProgress {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgePointId String
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  status           ProgressStatus @default(locked)
  bestScore        Int            @default(0)
  passedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, knowledgePointId])
  @@map("user_progress")
}

model UserSyllabusProgress {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabusItemId String
  syllabusItem   SyllabusItem   @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  status         ProgressStatus @default(locked)
  bestScore      Int            @default(0)
  passedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, syllabusItemId])
  @@index([syllabusItemId])
  @@map("user_syllabus_progress")
}

model QuestionAttempt {
  id            String                       @id @default(cuid())
  userId        String
  sessionId     String?
  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       QuizSession?                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question                     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer Json
  isCorrect     Boolean
  gradingStatus QuestionAttemptGradingStatus @default(auto_graded)
  createdAt     DateTime                     @default(now())

  @@index([userId, questionId])
  @@index([userId, gradingStatus, isCorrect])
  @@index([sessionId, questionId])
  @@index([sessionId, gradingStatus, isCorrect])
  @@map("question_attempts")
}

model QuizSession {
  id                        String                   @id @default(cuid())
  userId                    String
  syllabusItemId            String
  chapterChallengeVersionId String?
  status                    QuizSessionStatus        @default(in_progress)
  currentIndex              Int                      @default(0)
  score                     Int?
  correctCount              Int                      @default(0)
  totalCount                Int                      @default(0)
  diamondRewardAmount       Int                      @default(0)
  startedAt                 DateTime                 @default(now())
  completedAt               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabusItem              SyllabusItem             @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  chapterChallengeVersion   ChapterChallengeVersion? @relation(fields: [chapterChallengeVersionId], references: [id], onDelete: SetNull)
  attempts                  QuestionAttempt[]

  @@index([userId, syllabusItemId, status, updatedAt])
  @@index([syllabusItemId])
  @@index([chapterChallengeVersionId])
  @@map("quiz_sessions")
}

model ChapterChallengeVersion {
  id                  String                     @id @default(cuid())
  chapterId           String
  version             Int
