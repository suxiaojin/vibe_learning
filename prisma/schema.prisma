  summary        String               @db.Text
  sortOrder      Int                  @default(0)
  depth          Int                  @default(0)
  sourceChunkIds Json
  status         AiStudyNodeStatus    @default(draft)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  project        AiStudyProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         AiStudyNode?         @relation("AiStudyNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children       AiStudyNode[]        @relation("AiStudyNodeChildren")
  cards          AiStudyCard[]
  progress       AiStudyProgress[]
  chatMessages   AiStudyChatMessage[]

  @@index([projectId, parentId, sortOrder])
  @@index([projectId, status])
  @@map("ai_study_nodes")
}

model AiStudyCard {
  id            String                  @id @default(cuid())
  projectId     String
  nodeId        String
  overview      String                  @db.Text
  explanation   String                  @db.Text
  keyPoints     Json
  pitfalls      Json
  examples      Json
  flashcards    Json
  modelName     String?
  promptVersion String?
  aiPromptVersionId String?
  reviewStatus  AiStudyCardReviewStatus @default(unreviewed)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  project       AiStudyProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node          AiStudyNode             @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  aiPromptVersion AiStudyPromptVersion? @relation(fields: [aiPromptVersionId], references: [id], onDelete: SetNull)

  @@unique([nodeId])
  @@index([projectId, reviewStatus])
  @@index([aiPromptVersionId])
  @@map("ai_study_cards")
}

model AiStudyProgress {
  id            String                @id @default(cuid())
  userId        String
  projectId     String
  nodeId        String
  status        AiStudyProgressStatus @default(not_started)
  lastStudiedAt DateTime?
  masteredAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       AiStudyProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node          AiStudyNode           @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([projectId, status])
  @@index([userId, projectId])
  @@map("ai_study_progress")
}

model AiStudyChatMessage {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  projectId String         @map("project_id")
  nodeId    String?        @map("node_id")
  aiPromptVersionId String? @map("ai_prompt_version_id")
  role      String
  content   String         @db.Text
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   AiStudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node      AiStudyNode?   @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  aiPromptVersion AiStudyPromptVersion? @relation(fields: [aiPromptVersionId], references: [id], onDelete: SetNull)

  @@index([userId, projectId, nodeId, createdAt], map: "ai_study_chat_messages_user_project_node_created_idx")
  @@index([projectId, createdAt], map: "ai_study_chat_messages_project_created_idx")
  @@index([aiPromptVersionId], map: "ai_study_chat_messages_prompt_version_idx")
  @@map("ai_study_chat_messages")
}

model AiStudyGenerationTask {
  id            String            @id @default(cuid())
  projectId     String
  sourceId      String?
  type          AiStudyTaskType
  status        AiStudyTaskStatus @default(pending)
  stage         String?
  inputSummary  Json?
  outputSummary Json?
  errorMessage  String?           @db.Text
  retryCount    Int               @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  project       AiStudyProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source        AiStudySource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([status, type, createdAt])
  @@index([projectId, status, createdAt])
  @@index([sourceId])
  @@map("ai_study_generation_tasks")
}
