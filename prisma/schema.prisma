generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  admin
}

enum ContentStatus {
  draft
  published
  archived
}

enum RegionStatus {
  active
  inactive
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
}

enum Difficulty {
  easy
  medium
  hard
}

enum ProgressStatus {
  locked
  unlocked
  passed
}

enum WrongQuestionStatus {
  active
  mastered
}

model User {
  id              String            @id @default(cuid())
  username        String            @unique
  passwordHash    String
  role            UserRole          @default(student)
  createdAt       DateTime          @default(now())
  lastLoginAt     DateTime?
  studentProfile  StudentProfile?
  progress        UserProgress[]
  attempts        QuestionAttempt[]
  wrongQuestions  WrongQuestion[]
  aiConversations AiConversation[]
  studyStats      StudyStat[]

  @@map("users")
}

model Region {
  id              String                @id @default(cuid())
  name            String                @unique
  province        String
  studySystem     String
  description     String?
  status          RegionStatus          @default(active)
  sortOrder       Int                   @default(0)
  publicSubjects  RegionPublicSubject[]
  majors          RegionMajor[]
  studentProfiles StudentProfile[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([province, studySystem])
  @@index([status, sortOrder])
  @@map("regions")
}

model PublicSubject {
  id              String                @id @default(cuid())
  name            String                @unique
  code            String?               @unique
  description     String?
  status          ContentStatus         @default(draft)
  sortOrder       Int                   @default(0)
  regions         RegionPublicSubject[]
  studentProfiles StudentProfile[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, sortOrder])
  @@map("public_subjects")
}

model Major {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  status          ContentStatus    @default(draft)
  sortOrder       Int              @default(0)
  regions         RegionMajor[]
  studentProfiles StudentProfile[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, sortOrder])
  @@map("majors")
}

model RegionPublicSubject {
  id              String        @id @default(cuid())
  regionId        String
  publicSubjectId String
  region          Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  publicSubject   PublicSubject @relation(fields: [publicSubjectId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([regionId, publicSubjectId])
  @@index([regionId])
  @@index([publicSubjectId])
  @@map("region_public_subjects")
}

model RegionMajor {
  id        String   @id @default(cuid())
  regionId  String
  majorId   String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  major     Major    @relation(fields: [majorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([regionId, majorId])
  @@index([regionId])
  @@index([majorId])
  @@map("region_majors")
}

model StudentProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  regionId        String?
  publicSubjectId String?
  majorId         String?
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  region          Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  publicSubject   PublicSubject? @relation(fields: [publicSubjectId], references: [id], onDelete: SetNull)
  major           Major?         @relation(fields: [majorId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([regionId])
  @@index([publicSubjectId])
  @@index([majorId])
  @@map("student_profiles")
}

model Subject {
  id        String        @id @default(cuid())
  province  String
  examType  String
  name      String
  status    ContentStatus @default(published)
  chapters  Chapter[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([province, examType, name])
  @@map("subjects")
}

model Chapter {
  id        String           @id @default(cuid())
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int              @default(0)
  status    ContentStatus    @default(draft)
  points    KnowledgePoint[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([subjectId, sortOrder])
  @@map("chapters")
}

model KnowledgePoint {
  id               String         @id @default(cuid())
  chapterId        String
  chapter          Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title            String
  summary          String
  content          String
  sortOrder        Int            @default(0)
  estimatedMinutes Int            @default(8)
  status           ContentStatus  @default(draft)
  questions        Question[]
  progress         UserProgress[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([chapterId, sortOrder])
  @@map("knowledge_points")
}

model Question {
  id               String            @id @default(cuid())
  knowledgePointId String
  knowledgePoint   KnowledgePoint    @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  type             QuestionType
  stem             String
  options          Json
  answer           Json
  analysis         String
  source           String            @default("人工录入")
  difficulty       Difficulty        @default(medium)
  status           ContentStatus     @default(draft)
  attempts         QuestionAttempt[]
  wrongQuestions   WrongQuestion[]
  aiConversations  AiConversation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([knowledgePointId, status])
  @@map("questions")
}

model UserProgress {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgePointId String
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  status           ProgressStatus @default(locked)
  bestScore        Int            @default(0)
  passedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, knowledgePointId])
  @@map("user_progress")
}

model QuestionAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer Json
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  @@index([userId, questionId])
  @@map("question_attempts")
}

model WrongQuestion {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status      WrongQuestionStatus @default(active)
  wrongCount  Int                 @default(1)
  lastWrongAt DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([userId, questionId])
  @@map("wrong_questions")
}

model AiConversation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  messages   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, questionId])
  @@map("ai_conversations")
}

model StudyStat {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  studySeconds      Int      @default(0)
  questionsAnswered Int      @default(0)
  pointsPassed      Int      @default(0)

  @@unique([userId, date])
  @@map("study_stats")
}
