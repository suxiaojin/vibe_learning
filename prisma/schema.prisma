generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  admin
}

enum UserStatus {
  active
  disabled
}

enum StudentGender {
  male
  female
}

enum DiamondTransactionType {
  register_bonus
  daily_active_bonus
  daily_answer_bonus
  purchase
  admin_adjust
  ai_consumption
}

enum ContentStatus {
  draft
  published
  archived
}

enum RegionStatus {
  active
  inactive
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  fill_blank
  calculation
  proof
  comprehensive
  term_explanation
  calculation_analysis
  practical_writing
  short_answer
  essay
  comprehensive_analysis
  material_analysis
  operation_record
  practical_operation
  application
  question_answer
  handwriting
  reading_comprehension
  classical_chinese_translation
  writing
  legal_document
  chinese_character_writing
  language_expression
  teaching_design
  comprehensive_essay
}

enum Difficulty {
  easy
  medium
  hard
}

enum ProgressStatus {
  locked
  unlocked
  passed
}

enum WrongQuestionStatus {
  active
  mastered
}

enum LearningCourseType {
  public_subject
  major
}

enum SyllabusRequirement {
  know
  understand
  master
  apply
}

enum PaperType {
  real_exam
  mock_exam
  practice_set
}

enum QuestionSourceType {
  manual
  real_exam
  outline
  import
  ai_generated
}

enum QuestionKnowledgeTagSource {
  ai
  manual
}

model User {
  id              String            @id @default(cuid())
  username        String            @unique
  passwordHash    String
  role            UserRole          @default(student)
  status          UserStatus        @default(active)
  createdAt       DateTime          @default(now())
  lastLoginAt     DateTime?
  disabledAt      DateTime?
  disabledReason  String?
  studentProfile  StudentProfile?
  progress        UserProgress[]
  attempts        QuestionAttempt[]
  wrongQuestions  WrongQuestion[]
  aiConversations AiConversation[]
  studyStats      StudyStat[]
  syllabusProgress UserSyllabusProgress[]
  diamondAccount  DiamondAccount?
  diamondTransactions DiamondTransaction[]

  @@index([role, status, createdAt])
  @@map("users")
}

model AdminModule {
  id        String        @id @default(cuid())
  key       String        @unique
  label     String
  href      String
  icon      String        @default("settings")
  status    ContentStatus @default(published)
  sortOrder Int           @default(0)
  builtIn   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
  @@map("admin_modules")
}

model Region {
  id              String                @id @default(cuid())
  name            String                @unique
  province        String
  studySystem     String
  description     String?
  status          RegionStatus          @default(active)
  sortOrder       Int                   @default(0)
  publicSubjects  RegionPublicSubject[]
  majors          RegionMajor[]
  studentProfiles StudentProfile[]
  learningCourses LearningCourse[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([province, studySystem])
  @@index([status, sortOrder])
  @@map("regions")
}

model PublicSubject {
  id              String                @id @default(cuid())
  name            String                @unique
  code            String?               @unique
  description     String?
  status          ContentStatus         @default(draft)
  sortOrder       Int                   @default(0)
  regions         RegionPublicSubject[]
  studentProfiles StudentProfile[]
  learningCourses LearningCourse[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, sortOrder])
  @@map("public_subjects")
}

model Major {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  status          ContentStatus    @default(draft)
  sortOrder       Int              @default(0)
  regions         RegionMajor[]
  studentProfiles StudentProfile[]
  learningCourses LearningCourse[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, sortOrder])
  @@map("majors")
}

model RegionPublicSubject {
  id              String        @id @default(cuid())
  regionId        String
  publicSubjectId String
  region          Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  publicSubject   PublicSubject @relation(fields: [publicSubjectId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([regionId, publicSubjectId])
  @@index([regionId])
  @@index([publicSubjectId])
  @@map("region_public_subjects")
}

model RegionMajor {
  id        String   @id @default(cuid())
  regionId  String
  majorId   String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  major     Major    @relation(fields: [majorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([regionId, majorId])
  @@index([regionId])
  @@index([majorId])
  @@map("region_majors")
}

model StudentProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  regionId        String?
  publicSubjectId String?
  majorId         String?
  nickname        String?
  avatarColor     String         @default("green")
  avatarImage     String?
  gender          StudentGender?
  school          String?
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  region          Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  publicSubject   PublicSubject? @relation(fields: [publicSubjectId], references: [id], onDelete: SetNull)
  major           Major?         @relation(fields: [majorId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([regionId])
  @@index([publicSubjectId])
  @@index([majorId])
  @@map("student_profiles")
}

model LearningCourse {
  id              String             @id @default(cuid())
  regionId        String
  publicSubjectId String?
  majorId         String?
  name            String
  courseType      LearningCourseType
  description     String?
  status          ContentStatus      @default(draft)
  sortOrder       Int                @default(0)
  region          Region             @relation(fields: [regionId], references: [id], onDelete: Cascade)
  publicSubject   PublicSubject?     @relation(fields: [publicSubjectId], references: [id], onDelete: SetNull)
  major           Major?             @relation(fields: [majorId], references: [id], onDelete: SetNull)
  chapters        Chapter[]
  syllabusItems   SyllabusItem[]
  examPapers      ExamPaper[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([regionId, courseType, status, sortOrder])
  @@index([publicSubjectId])
  @@index([majorId])
  @@map("learning_courses")
}

model SyllabusItem {
  id              String               @id @default(cuid())
  courseId        String
  parentId        String?
  code            String?
  title           String
  description     String?
  requirement     SyllabusRequirement?
  sortOrder       Int                  @default(0)
  status          ContentStatus        @default(draft)
  course          LearningCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent          SyllabusItem?        @relation("SyllabusItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children        SyllabusItem[]       @relation("SyllabusItemChildren")
  knowledgePoints KnowledgePoint[]
  progress        UserSyllabusProgress[]
  questions       Question[]
  questionTags    QuestionKnowledgeTag[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([courseId, parentId, sortOrder])
  @@index([status, sortOrder])
  @@map("syllabus_items")
}

model Subject {
  id        String        @id @default(cuid())
  province  String
  examType  String
  name      String
  status    ContentStatus @default(published)
  chapters  Chapter[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([province, examType, name])
  @@map("subjects")
}

model Chapter {
  id        String           @id @default(cuid())
  subjectId String
  courseId  String?
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course    LearningCourse?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title     String
  sortOrder Int              @default(0)
  status    ContentStatus    @default(draft)
  points    KnowledgePoint[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([subjectId, sortOrder])
  @@index([courseId, sortOrder])
  @@map("chapters")
}

model KnowledgePoint {
  id               String         @id @default(cuid())
  chapterId        String
  syllabusItemId   String?
  chapter          Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  syllabusItem     SyllabusItem?  @relation(fields: [syllabusItemId], references: [id], onDelete: SetNull)
  title            String
  summary          String
  content          String
  sortOrder        Int            @default(0)
  estimatedMinutes Int            @default(8)
  status           ContentStatus  @default(draft)
  questions        Question[]
  progress         UserProgress[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([chapterId, sortOrder])
  @@index([syllabusItemId])
  @@map("knowledge_points")
}

model Question {
  id               String            @id @default(cuid())
  knowledgePointId String
  syllabusItemId   String?
  knowledgePoint   KnowledgePoint    @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  syllabusItem     SyllabusItem?     @relation(fields: [syllabusItemId], references: [id], onDelete: SetNull)
  type             QuestionType
  stem             String
  options          Json
  answer           Json
  analysis         String
  source           String            @default("人工录入")
  sourceType       QuestionSourceType @default(manual)
  sourceYear       Int?
  difficulty       Difficulty        @default(medium)
  status           ContentStatus     @default(draft)
  paperQuestions   ExamPaperQuestion[]
  knowledgeTags    QuestionKnowledgeTag[]
  attempts         QuestionAttempt[]
  wrongQuestions   WrongQuestion[]
  aiConversations  AiConversation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([knowledgePointId, status])
  @@index([syllabusItemId])
  @@index([sourceType, sourceYear])
  @@map("questions")
}

model QuestionKnowledgeTag {
  id             String                     @id @default(cuid())
  questionId     String
  syllabusItemId String
  source         QuestionKnowledgeTagSource @default(manual)
  confidence     Float?
  reason         String?
  question       Question                   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  syllabusItem   SyllabusItem               @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([questionId, syllabusItemId])
  @@index([questionId])
  @@index([syllabusItemId])
  @@index([source])
  @@map("question_knowledge_tags")
}

model ExamPaper {
  id          String              @id @default(cuid())
  courseId    String
  title       String
  year        Int?
  paperType   PaperType           @default(real_exam)
  description String?
  status      ContentStatus       @default(draft)
  sortOrder   Int                 @default(0)
  course      LearningCourse      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   ExamPaperQuestion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([courseId, status, sortOrder])
  @@index([year, paperType])
  @@map("exam_papers")
}

model ExamPaperQuestion {
  id        String    @id @default(cuid())
  paperId   String
  questionId String
  sortOrder Int       @default(0)
  score     Float?
  paper     ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([paperId, questionId])
  @@index([paperId, sortOrder])
  @@index([questionId])
  @@map("exam_paper_questions")
}

model UserProgress {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgePointId String
  knowledgePoint   KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  status           ProgressStatus @default(locked)
  bestScore        Int            @default(0)
  passedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, knowledgePointId])
  @@map("user_progress")
}

model UserSyllabusProgress {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  syllabusItemId String
  syllabusItem   SyllabusItem   @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  status         ProgressStatus @default(locked)
  bestScore      Int            @default(0)
  passedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, syllabusItemId])
  @@index([syllabusItemId])
  @@map("user_syllabus_progress")
}

model QuestionAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer Json
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  @@index([userId, questionId])
  @@map("question_attempts")
}

model WrongQuestion {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status      WrongQuestionStatus @default(active)
  wrongCount  Int                 @default(1)
  lastWrongAt DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([userId, questionId])
  @@map("wrong_questions")
}

model AiConversation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  messages   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, questionId])
  @@map("ai_conversations")
}

model StudyStat {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  studySeconds      Int      @default(0)
  questionsAnswered Int      @default(0)
  pointsPassed      Int      @default(0)

  @@unique([userId, date])
  @@map("study_stats")
}

model DiamondAccount {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int                  @default(0)
  transactions DiamondTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("diamond_accounts")
}

model DiamondTransaction {
  id           String                 @id @default(cuid())
  userId       String
  accountId    String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      DiamondAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         DiamondTransactionType
  amount       Int
  balanceAfter Int
  occurredOn   DateTime               @db.Date
  dedupeKey    String?                @unique
  note         String?
  metadata     Json?
  createdAt    DateTime               @default(now())

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([type, occurredOn])
  @@map("diamond_transactions")
}
