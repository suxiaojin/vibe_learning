[Unit]
Description=Vibe Learning English V1 Reading Parser
After=network.target

[Service]
WorkingDirectory=/opt/vibe_pdf_parser/versions/english
ExecStart=/opt/vibe_pdf_parser/version-envs/english/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8006
Restart=always

[Install]
WantedBy=multi-user.target
